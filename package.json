{
  "name": "venueflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite",
    "build": "npm run build:client && tsc --noEmit",
    "build:client": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:baseline": "npm run build && wrangler deploy --env baseline",
    "db:migrate:local": "wrangler d1 migrations apply venueflow-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply venueflow-production --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/react": "^6.16.1",
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.33",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^4.12.0"
  }
}
